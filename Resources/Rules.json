    "DisplayName": "Windows 临时文件",
    "Paths": [ "%TEMP%", "C:\\Windows\\Temp" ],
    "Risk": "Low",
    "Explanation": "系统和软件运行时产生的临时文件,删除不影响任何软件正常使用",
    "Reversible": false,
    "DeleteDirectoryItself": false
  },
  {
    "Id": "sys_prefetch",
    "Category": "系统临时文件",
    "DisplayName": "Prefetch 预读取缓存",
    "Paths": [ "C:\\Windows\\Prefetch" ],
    "Risk": "Low",
    "Explanation": "系统用于加速程序启动的预读取缓存,删除后首次启动相关程序会略慢,之后自动重建",
    "Reversible": false,
    "DeleteDirectoryItself": false
  },
  {
