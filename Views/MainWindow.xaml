<Window x:Class="CleanMaster.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanMaster"
        Width="880" Height="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="False"
        Background="{StaticResource BgPrimary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <!-- ===== 自定义标题栏 ===== -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondary}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="CleanMaster" Foreground="{StaticResource TextPrimary}"
                               FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="  垃圾清理" Foreground="{StaticResource TextSecondary}"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="—" Width="46" Height="48" Background="Transparent" Foreground="{StaticResource TextSecondary}"
                            BorderThickness="0" Click="Minimize_Click"/>
                    <Button Content="✕" Width="46" Height="48" Background="Transparent" Foreground="{StaticResource TextSecondary}"
                            BorderThickness="0" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 主内容区 ===== -->
        <ScrollViewer Grid.Row="1" Padding="24,16">
            <StackPanel>

                <!-- 顶部概览:扫描按钮 + 释放空间大数字 -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="可释放空间" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                            <TextBlock x:Name="TotalSizeText" Text="— 未扫描 —"
                                       Foreground="{StaticResource TextPrimary}" FontSize="34" FontWeight="Bold"/>
                            <TextBlock x:Name="ScanStatusText" Text="点击右侧按钮开始扫描"
                                       Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" x:Name="ScanButton" Content="开始扫描"
                                Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Center" Click="ScanButton_Click" Width="140"/>
                    </Grid>
                </Border>

                <!-- 分类结果:低风险 -->
                <TextBlock Text="✅ 可以安全清理" Foreground="{StaticResource RiskLow}"
                           FontWeight="SemiBold" FontSize="14" Margin="4,16,0,8"/>
                <ItemsControl x:Name="LowRiskList" ItemTemplate="{StaticResource ScanItemTemplate}"/>

                <!-- 分类结果:建议逐项确认 -->
                <TextBlock Text="⚠️ 建议您逐项确认" Foreground="{StaticResource RiskMedium}"
                           FontWeight="SemiBold" FontSize="14" Margin="4,16,0,8"/>
                <ItemsControl x:Name="MediumRiskList" ItemTemplate="{StaticResource ScanItemTemplate}"/>

                <!-- 分类结果:不会触碰 -->
                <TextBlock Text="🔒 本工具不会触碰" Foreground="{StaticResource RiskExcluded}"
                           FontWeight="SemiBold" FontSize="14" Margin="4,16,0,8"/>
                <Border Style="{StaticResource CardStyle}">
                    <ItemsControl x:Name="ExcludedNotesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondary}"
                                           FontSize="13" Margin="0,3,0,3" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== 底部操作栏 ===== -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondary}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SelectionSummaryText" Text="尚未勾选任何项目"
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>

                <Button Grid.Column="1" Content="取消勾选" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0" Click="ClearSelection_Click"/>
                <Button Grid.Column="2" x:Name="CleanButton" Content="清理已勾选项"
                        Style="{StaticResource PrimaryButton}" Width="160"
                        IsEnabled="False" Click="CleanButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
